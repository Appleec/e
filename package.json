{
  "name": "@elinzy/e",
  "version": "0.1.1",
  "description": "The collection of e modules",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm -r --filter=./packages/* dev",
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r test",
    "test:report": "vitest --ui --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm root:lint && pnpm -r lint",
    "lint:fix": "pnpm root:lint:fix && pnpm -r lint:fix",
    "root:lint": "eslint .",
    "root:lint:fix": "eslint . --fix",
    "format": "pnpm root:format && pnpm -r format",
    "format:fix": "pnpm root:format:fix && pnpm -r format:fix",
    "root:format": "prettier . --check --log-level silent",
    "root:format:fix": "prettier . --write --log-level silent",
    "prepare": "husky || true",
    "pkg:prepare": "pnpm changeset && pnpm changeset version",
    "pkg:publish": "pnpm -r build && pnpm changeset publish",
    "clean:dist": "pnpx rimraf dist && pnpm -r exec pnpx rimraf dist",
    "clean:node_modules": "pnpx rimraf node_modules && pnpm -r exec pnpx rimraf node_modules",
    "clean:all": "pnpm clean:node_modules && pnpm clean:dist",
    "lint:inspector": "pnpx @eslint/config-inspector",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm -C docs run docs:build",
    "docs:preview": "pnpm -C docs run docs:preview"
  },
  "keywords": [
    "e",
    "elinzy"
  ],
  "author": "Appleec <771992522@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Appleec/e.git"
  },
  "bugs": {
    "url": "https://github.com/Appleec/e/issues"
  },
  "homepage": "https://github.com/Appleec/e#readme",
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@elinzy/eslint-config": "workspace:*",
    "@elinzy/lint-staged-config": "workspace:*",
    "@elinzy/prettier-config": "workspace:*",
    "@types/node": "^22.13.10",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "tsc-files": "^1.1.4",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0",
    "npm": "please-use-pnpm",
    "pnpm": ">=10.0.0",
    "yarn": "please-use-pnpm"
  }
}