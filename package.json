{
  "name": "@elinzy/e",
  "version": "0.1.1",
  "description": "The collection of e modules",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter=./packages/* dev",
    "build": "pnpm -r --filter=./packages/* build",
    "test": "vitest run",
    "test:report": "vitest --ui --coverage",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --ignore-path .prettierignore --check \"**/*.{js,mjs,cjs,ts,md}\"",
    "format:fix": "pnpm format --write",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm -C docs run docs:build",
    "docs:preview": "pnpm -C docs run docs:preview"
  },
  "keywords": [
    "e",
    "elinzy"
  ],
  "author": "Appleec <771992522@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Appleec/e.git"
  },
  "bugs": {
    "url": "https://github.com/Appleec/e/issues"
  },
  "homepage": "https://github.com/Appleec/e#readme",
  "devDependencies": {
    "@changesets/cli": "2.29.3",
    "@elinzy/eslint-config-extended": "workspace:*",
    "@elinzy/tsconfig": "workspace:*",
    "@types/node": "^22.13.10",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "ansis": "^3.17.0",
    "clean-publish": "5.1.0",
    "eslint": "^9.22.0",
    "eslint-import-resolver-next": "0.6.0",
    "eslint-plugin-import-x": "4.15.2",
    "eslint-plugin-n": "17.16.2",
    "execa": "^9.5.2",
    "globals": "^16.0.0",
    "import-meta-resolve": "4.1.0",
    "jsdom": "^25.0.0",
    "nanospinner": "^1.2.2",
    "prettier": "^3.5.3",
    "prompts": "^2.4.2",
    "rimraf": "6.1.0",
    "tsdown": "0.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
