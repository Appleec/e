{
  "name": "@elinzy/core",
  "version": "0.2.0",
  "description": "e core implementation module",
	"homepage": "https://github.com/Appleec/e#readme",
	"bugs": {
		"url": "https://github.com/Appleec/e/issues"
	},
	"license": "MIT",
	"author": "Appleec <771992522@qq.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Appleec/e.git",
		"directory": "packages/core"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"keywords": [
		"e",
		"core"
	],
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"module": "./dist/index.mjs",
	"scripts": {
		"dev": "tsdown --watch",
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./child_process": {
			"import": "./dist/child_process.mjs",
			"require": "./dist/child_process.cjs"
		},
		"./package.json": "./package.json"
	},
	"dependencies": {
		"ansis": "4.2.0",
		"execa": "^9.5.2"
	},
	"devDependencies": {
		"tsdown": "catalog:"
	},
	"engines": {
		"node": "^18.18.0 || ^20.9.0 || >=21.1.0",
		"npm": ">=10.9.0",
		"pnpm": ">=10.0.0",
		"yarn": ">=4.5.2"
	}
}
