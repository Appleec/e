{
    "name": "@elinzy/git",
    "version": "0.1.2",
    "description": "Git for e, a collection of common scripts and commands",
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": {
                "import": "./dist/index.d.mts",
                "require": "./dist/index.d.cts",
                "default": "./dist/index.d.mts"
            },
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Appleec/e.git",
        "directory": "packages/git"
    },
    "keywords": [
        "e",
        "git"
    ],
    "author": "Appleec <771992522@qq.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Appleec/e/issues"
    },
    "homepage": "https://github.com/Appleec/e#readme",
    "devDependencies": {
    "tsdown": "catalog:",
        "@elinzy/core": "workspace:*"
    }
}