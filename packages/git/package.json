{
    "name": "@elinzy/git",
    "version": "0.1.0",
    "description": "Git for e, a collection of common scripts and commands",
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "rollup --config rollup.config.mjs --watch",
        "build": "npm-run-all --parallel build:clean build:main build:type",
        "build:main": "rollup --config rollup.config.mjs",
        "build:type": "tsc --project tsconfig.build.json --emitDeclarationOnly --preserveWatchOutput",
        "build:clean": "rimraf ./dist",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Appleec/e.git",
        "directory": "packages/git"
    },
    "keywords": [
        "e",
        "git"
    ],
    "author": "Appleec <771992522@qq.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Appleec/e/issues"
    },
    "homepage": "https://github.com/Appleec/e#readme",
    "devDependencies": {
        "@elinzy/core": "workspace:*"
    }
}
