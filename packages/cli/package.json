{
  "name": "@elinzy/cli",
  "version": "0.1.3",
  "description": "A collection of common scripts and commands for e",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "bin": {
    "e": "./dist/index.mjs",
    "e-cli": "./dist/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Appleec/e.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "e",
    "cli"
  ],
  "author": "Appleec <771992522@qq.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Appleec/e/issues"
  },
  "homepage": "https://github.com/Appleec/e#readme",
  "dependencies": {
    "@elinzy/core": "workspace:^",
    "@elinzy/logger": "workspace:*",
    "ansis": "^3.17.0",
    "commander": "^14.0.3",
    "conventional-changelog": "^6.0.0",
    "nanospinner": "^1.2.2",
    "node-fetch": "3.3.2",
    "package-manager-detector": "1.6.0",
    "prompts": "^2.4.2",
    "semver": "^7.7.1"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  }
}