{
    "name": "@elinzy/errors",
    "version": "0.1.0",
    "description": "Error classes for e",
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "scripts": {
        "dev": "rollup -c -w",
        "build": "npm-run-all --parallel build:clean build:main build:type",
        "build:main": "rollup -c",
        "build:type": "tsc -p tsconfig.build.json --emitDeclarationOnly",
        "build:clean": "rimraf ./dist",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Appleec/e.git",
        "directory": "packages/errors"
    },
    "keywords": [
        "e",
        "errors"
    ],
    "author": "Appleec <771992522@qq.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Appleec/e/issues"
    },
    "homepage": "https://github.com/Appleec/e#readme",
    "dependencies": {
        "extendable-error": "0.1.7"
    }
}
