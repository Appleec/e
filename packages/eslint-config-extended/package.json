{
  "name": "@elinzy/eslint-config-extended",
  "version": "1.0.1",
  "description": "Common ESLint configuration for e",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./legacy": "./dist/legacy.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Appleec/e.git",
    "directory": "packages/eslint-config-extended"
  },
  "keywords": [
    "e",
    "eslint",
    "config",
    "eslint-config"
  ],
  "author": {
    "name": "Appleec",
    "email": "771992522@qq.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Appleec/e/issues"
  },
  "homepage": "https://github.com/Appleec/e#readme",
  "devDependencies": {
    "tsdown": "catalog:",
    "@elinzy/vitest-config": "workspace:*",
    "@types/confusing-browser-globals": "^1.0.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "^16.3.8",
    "@stylistic/eslint-plugin": "5.10.0",
    "confusing-browser-globals": "1.0.11",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "get-tsconfig": "^4.14.3",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": false
    }
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  }
}
