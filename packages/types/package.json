{
  "name": "@elinzy/types",
  "version": "0.1.0",
  "description": "Common types shared for e",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
		"dev": "rollup --config rollup.config.mjs --watch",
		"build": "npm-run-all --parallel build:clean build:main build:type",
		"build:main": "rollup --config rollup.config.mjs",
		"build:type": "tsc --project tsconfig.build.json --emitDeclarationOnly --preserveWatchOutput",
		"build:clean": "rimraf ./dist",
		"test": "echo \"Error: no test specified\" && exit 1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Appleec/e.git",
    "directory": "packages/types"
  },
  "keywords": [
    "e",
    "types"
  ],
  "author": {
    "name": "Appleec",
    "email": "771992522@qq.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Appleec/e/issues"
  },
  "homepage": "https://github.com/Appleec/e#readme",
	"peerDependencies": {
		"typescript": "catalog:"
	}
}
